# Server
PORT=8080
ALLOWED_ORIGIN=*

# Postgres. POSTGRES_PASSWORD and JWT_SECRET have no defaults on purpose:
# compose refuses to start without them rather than booting something guessable.
POSTGRES_USER=introduce
POSTGRES_PASSWORD=
POSTGRES_DB=introduce

# Set only when running the binary outside compose.
DATABASE_URL=postgres://introduce:PASSWORD@localhost:5432/introduce?sslmode=disable

# Signing key for access tokens. At least 32 characters.
# Generate with: openssl rand -base64 48
JWT_SECRET=

# Media
UPLOADS_DIR=./uploads
FILES_BASE_URL=https://files.introduce.TU_DOMINIO.com
